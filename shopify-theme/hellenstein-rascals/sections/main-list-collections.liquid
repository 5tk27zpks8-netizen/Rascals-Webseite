<section class="collection-page page-width"><header class="page-hero-small"><p class="eyebrow">OFFICIAL TEAM STORE</p><h1>KOLLEKTIONEN</h1></header><div class="collection-list">{% for collection in collections %}<a href="{{ collection.url }}">{% if collection.featured_image %}{{ collection.featured_image | image_url: width: 900 | image_tag: loading: 'lazy', alt: collection.title }}{% endif %}<h2>{{ collection.title }}</h2><span>{{ collection.products_count }} Produkte →</span></a>{% endfor %}</div></section>
{% schema %}{ "name": "Kollektionen", "settings": [] }{% endschema %}
