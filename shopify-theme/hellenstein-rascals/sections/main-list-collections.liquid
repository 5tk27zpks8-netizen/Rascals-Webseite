{% comment %}
  Vorher lief eine Schleife über alle Sammlungen des Shops, alle gleich gross
  in einer Reihe. Mit drei Linien und fünf Kategorien wären das acht
  gleichberechtigte Kacheln ohne Aussage darüber, was wovon eine Unterteilung
  ist.

  Jetzt zwei Blöcke: die Linien gross, weil das die Entscheidung ist, mit der
  jemand in den Shop einsteigt, die Kategorien als Reihe darunter. Beide
  Listen werden im Theme-Editor gesetzt, nicht aus allen Sammlungen geraten —
  sonst stehen Automatik- und Aktionslisten zwischen den Linien.

  Ist nichts gesetzt, rendert wieder die alte Schleife. Die Seite ist nie leer.
{% endcomment %}

{%- assign lines = section.settings.lines -%}
{%- assign categories = section.settings.categories -%}
{%- assign lines_size = lines | size -%}
{%- assign categories_size = categories | size -%}

<section class="collection-page page-width">
  <header class="page-hero-small">
    <p class="eyebrow">{{ section.settings.eyebrow }}</p>
    <h1>{{ section.settings.heading }}</h1>
    {% if section.settings.text != blank %}<div class="rte">{{ section.settings.text }}</div>{% endif %}
  </header>

  {% if lines_size > 0 or categories_size > 0 %}

    {% if lines_size > 0 %}
      <div class="collection-list">
        {% for collection in lines %}
          <a href="{{ collection.url }}">
            {% if collection.featured_image %}{{ collection.featured_image | image_url: width: 900 | image_tag: loading: 'lazy', alt: collection.title }}{% endif %}
            <h2>{{ collection.title }}</h2>
            <span>{{ collection.products_count }} Produkte &rarr;</span>
          </a>
        {% endfor %}
      </div>
    {% endif %}

    {% if categories_size > 0 %}
      <h2 class="category-row-heading">{{ section.settings.categories_heading }}</h2>
      <div class="category-row">
        {% for collection in categories %}
          <a href="{{ collection.url }}">
            {% if collection.featured_image %}{{ collection.featured_image | image_url: width: 600 | image_tag: loading: 'lazy', alt: collection.title }}{% endif %}
            <b>{{ collection.title }}</b>
            <small>{{ collection.products_count }} Produkte</small>
          </a>
        {% endfor %}
      </div>
    {% endif %}

  {% else %}

    <div class="collection-list">
      {% for collection in collections %}
        <a href="{{ collection.url }}">
          {% if collection.featured_image %}{{ collection.featured_image | image_url: width: 900 | image_tag: loading: 'lazy', alt: collection.title }}{% endif %}
          <h2>{{ collection.title }}</h2>
          <span>{{ collection.products_count }} Produkte &rarr;</span>
        </a>
      {% endfor %}
    </div>

  {% endif %}
</section>

{% schema %}
{
  "name": "Kollektionen",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Kleine Überschrift", "default": "OFFICIAL TEAM STORE" },
    { "type": "text", "id": "heading", "label": "Überschrift", "default": "KOLLEKTIONEN" },
    { "type": "richtext", "id": "text", "label": "Einleitung" },
    { "type": "header", "content": "Linien" },
    { "type": "collection_list", "id": "lines", "label": "Old-School, Basic, Standard", "limit": 6 },
    { "type": "header", "content": "Kategorien" },
    { "type": "text", "id": "categories_heading", "label": "Überschrift", "default": "NACH KATEGORIE" },
    { "type": "collection_list", "id": "categories", "label": "Mützen, Pullover, Jacken …", "limit": 12 }
  ]
}
{% endschema %}
