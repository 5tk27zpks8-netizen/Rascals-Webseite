{% comment %}
  DIE NAVIGATION WAR FEST EINPROGRAMMIERT.

  "Shop / Team / Über uns / Service" standen als fünf <a> im Code. Im
  Shopify-Admin liess sich daran nichts ändern — es gab kein Menü, auf das
  das Theme geschaut hätte. Ein Eintrag "Shop ▸ Old-School / Basic / Standard"
  war damit nicht möglich, egal was man im Admin angelegt hätte.

  Jetzt wird ein echtes Menü gelesen, mit zweiter Ebene. Das Aufklappen läuft
  über :hover und :focus-within, ohne JavaScript, damit es auch per Tabulator
  geht und nicht mit dem mobilen Menü kollidiert, das sein eigenes Skript hat.

  SOLANGE KEIN MENÜ GESETZT IST, BLEIBT ALLES WIE ES WAR.

  Ohne zugewiesenes Menü rendert exakt die alte Linkleiste. Der Shop sieht
  also unverändert aus, bis jemand im Admin ein Menü einträgt — kein Zustand
  dazwischen, in dem die Kopfzeile leer ist.
{% endcomment %}

{% liquid
  assign team_page = pages['team']
  if team_page != blank
    assign team_url = team_page.url
  else
    assign team_url = '/pages/team'
  endif
  assign menu = section.settings.menu
%}
{% if section.settings.announcement_text != blank %}
  <div class="announcement">
    {% if section.settings.announcement_link != blank %}<a href="{{ section.settings.announcement_link }}">{% endif %}
      {{ section.settings.announcement_text }}
    {% if section.settings.announcement_link != blank %}</a>{% endif %}
  </div>
{% endif %}
<header class="site-header" data-site-header>
  <a class="site-brand" href="{{ routes.root_url }}" aria-label="{{ shop.name | escape }} – Startseite">
    {% if settings.logo != blank %}
      {{ settings.logo | image_url: width: 360 | image_tag: class: 'brand-logo', widths: '120,180,240,360', alt: shop.name }}
    {% else %}
      <img class="brand-logo" src="{{ 'rascals-helmet-logo-clean.png' | asset_url }}" width="998" height="578" alt="">
    {% endif %}
    <span class="brand-wordmark">RASCALS</span>
  </a>

  <button class="menu-button" type="button" data-menu-toggle aria-controls="MainNavigation" aria-expanded="false" aria-label="Menü öffnen">
    <span></span><span></span><span></span>
  </button>

  <nav class="main-navigation" id="MainNavigation" data-menu aria-label="Hauptnavigation">
    {% if menu.links.size > 0 %}
      {% for link in menu.links %}
        {% if link.links.size > 0 %}
          <div class="nav-item has-subnav">
            <a href="{{ link.url }}"{% if link.current or link.child_active %} aria-current="page"{% endif %}>
              {{- link.title | escape -}}<i class="nav-caret" aria-hidden="true">&#9662;</i>
            </a>
            <div class="subnav">
              {% for child in link.links %}
                <a href="{{ child.url }}"{% if child.current %} aria-current="page"{% endif %}>{{ child.title | escape }}</a>
              {% endfor %}
            </div>
          </div>
        {% else %}
          <a href="{{ link.url }}"{% if link.current %} aria-current="page"{% endif %}>{{ link.title | escape }}</a>
        {% endif %}
      {% endfor %}
    {% else %}
      <a href="{{ routes.all_products_collection_url }}">Shop</a>
      <a href="{{ team_url }}">Team</a>
      <a href="{{ routes.root_url }}#story">Über uns</a>
      <a href="{{ routes.root_url }}#service">Service</a>
      {% if section.settings.show_sponsors_link %}<a href="{{ routes.root_url }}#sponsors">Sponsoren</a>{% endif %}
    {% endif %}
  </nav>

  <div class="header-actions">
    <a class="icon-link search-link" href="{{ routes.search_url }}" aria-label="Suche"><span class="search-icon"></span><span>Suche</span></a>
    <a class="icon-link cart-link" href="{{ routes.cart_url }}" aria-label="Warenkorb mit {{ cart.item_count }} Artikeln">
      <span class="bag-icon"></span><span>Warenkorb</span><b data-cart-count>{{ cart.item_count }}</b>
    </a>
  </div>
</header>

{% schema %}
{
  "name": "Rascals Header",
  "settings": [
    { "type": "link_list", "id": "menu", "label": "Menü", "info": "Ohne Auswahl bleibt die bisherige feste Linkleiste stehen. Unterpunkte werden als Aufklappmenü angezeigt." },
    { "type": "text", "id": "announcement_text", "label": "Hinweistext", "default": "Kostenloser Versand ab 80 € · Abholung beim nächsten Heimspiel möglich" },
    { "type": "url", "id": "announcement_link", "label": "Hinweis-Link" },
    { "type": "checkbox", "id": "show_sponsors_link", "label": "Sponsoren-Link anzeigen (nur ohne Menü)", "default": false }
  ]
}
{% endschema %}
