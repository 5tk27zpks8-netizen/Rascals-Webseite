{% liquid
  assign chosen_collection = collections[section.settings.collection]
  if chosen_collection == blank
    assign chosen_collection = collections['all']
  endif
%}
<section class="products-section page-width" id="shop-{{ section.id }}">
  <div class="section-heading">
    <div><p class="eyebrow">{{ section.settings.eyebrow }}</p><h2>{{ section.settings.heading }}</h2></div>
    <a class="text-link" href="{{ chosen_collection.url | default: routes.all_products_collection_url }}">Alle Produkte <span>→</span></a>
  </div>
  {% if chosen_collection.products_count > 0 %}
    <div class="product-grid">
      {% for product in chosen_collection.products limit: section.settings.products_to_show %}
        {% render 'product-card', product: product %}
      {% endfor %}
    </div>
  {% else %}
    <div class="empty-state"><b>DER ERSTE DROP KOMMT.</b><p>Sobald Produkte in Shopify angelegt sind, erscheinen sie automatisch hier.</p></div>
  {% endif %}
</section>

{% schema %}
{
  "name": "Rascals Produktreihe",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Kleine Überschrift", "default": "LATEST DROP" },
    { "type": "text", "id": "heading", "label": "Überschrift", "default": "NEW ARRIVALS" },
    { "type": "collection", "id": "collection", "label": "Kollektion" },
    { "type": "range", "id": "products_to_show", "label": "Produkte", "min": 4, "max": 12, "step": 4, "default": 4 }
  ],
  "presets": [{ "name": "Rascals Produktreihe" }]
}
{% endschema %}
