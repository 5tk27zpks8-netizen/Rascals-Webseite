{% if section.blocks.size > 0 %}
  <section class="sponsor-section" id="sponsors" aria-label="Sponsoren und Partner">
    <div class="sponsor-track">
      {% for repeat in (1..2) %}
        {% for block in section.blocks %}
          {% if block.settings.logo != blank %}
            <a href="{{ block.settings.link | default: '#' }}" aria-label="{{ block.settings.name | escape }}" {{ block.shopify_attributes }}>
              {{ block.settings.logo | image_url: width: 500 | image_tag: loading: 'lazy', alt: block.settings.name }}
            </a>
          {% endif %}
        {% endfor %}
      {% endfor %}
    </div>
  </section>
{% endif %}

{% schema %}
{
  "name": "Sponsoren-Logos",
  "max_blocks": 20,
  "settings": [],
  "blocks": [
    {
      "type": "sponsor",
      "name": "Sponsor",
      "settings": [
        { "type": "image_picker", "id": "logo", "label": "Logo" },
        { "type": "text", "id": "name", "label": "Name" },
        { "type": "url", "id": "link", "label": "Website" }
      ]
    }
  ],
  "presets": [{ "name": "Sponsoren-Logos" }]
}
{% endschema %}
