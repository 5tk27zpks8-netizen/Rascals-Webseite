<footer class="site-footer">
  <div class="field-lines" aria-hidden="true"></div>
  <div class="site-footer__grid page-width">
    <div class="footer-brand">
      <img src="{{ 'rascals-logo.png' | asset_url }}" width="280" height="140" loading="lazy" alt="Hellenstein Rascals">
      <p>{{ section.settings.text }}</p>
    </div>
    <div>
      <p class="footer-label">EXPLORE</p>
      {%- for link in section.settings.menu.links -%}<a href="{{ link.url }}">{{ link.title | escape }}</a>{%- endfor -%}
    </div>
    <div>
      <p class="footer-label">FOLLOW</p>
      {%- if settings.instagram_url != blank -%}<a href="{{ settings.instagram_url }}" target="_blank" rel="noopener">Instagram ↗</a>{%- endif -%}
      {%- if settings.facebook_url != blank -%}<a href="{{ settings.facebook_url }}" target="_blank" rel="noopener">Facebook ↗</a>{%- endif -%}
      <a href="mailto:football@hsb1846.de">E-Mail ↗</a>
    </div>
    <div class="footer-newsletter">
      <p class="footer-label">{{ section.settings.heading }}</p>
      {% form 'customer', class: 'newsletter-form' %}
        <input type="hidden" name="contact[tags]" value="newsletter">
        <label class="visually-hidden" for="FooterEmail-{{ section.id }}">E-Mail-Adresse</label>
        <input id="FooterEmail-{{ section.id }}" type="email" name="contact[email]" placeholder="DEINE E-MAIL" autocomplete="email" required>
        <button type="submit" aria-label="Newsletter abonnieren">→</button>
        {%- if form.posted_successfully? -%}<p>Willkommen im Huddle!</p>{%- endif -%}
        {{ form.errors | default_errors }}
      {% endform %}
    </div>
  </div>
  <div class="footer-bottom page-width"><small>© {{ 'now' | date: '%Y' }} {{ shop.name }}</small><span>ALL GRIT. ALL HEART.</span>{{ powered_by_link }}</div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": [
    { "type": "link_list", "id": "menu", "label": "Footer menu", "default": "footer" },
    { "type": "text", "id": "heading", "label": "Newsletter-Überschrift", "default": "JOIN THE HUDDLE" },
    { "type": "textarea", "id": "text", "label": "Body text", "default": "Teamwear für alle, die Rascals Football leben." }
  ]
}
{% endschema %}
