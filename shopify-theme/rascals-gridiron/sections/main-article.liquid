<article class="article-page">
  <header class="article-hero">
    {%- if article.image -%}{{ article.image | image_url: width: 2400 | image_tag: widths: '750, 1200, 1800, 2400', sizes: '100vw', loading: 'eager', alt: article.image.alt }}{%- else -%}<img src="{{ 'team-players.webp' | asset_url }}" width="3840" height="2160" loading="eager" alt="Hellenstein Rascals Team">{%- endif -%}
    <div class="article-hero__shade"></div><div class="article-hero__content page-width"><p class="eyebrow">{{ article.published_at | date: '%d.%m.%Y' }}</p><h1>{{ article.title | escape }}</h1>{%- if section.settings.show_author -%}<p>BY {{ article.author | upcase }}</p>{%- endif -%}</div>
  </header>
  <div class="article-content rte narrow reveal">{{ article.content }}</div>
  {%- if blog.comments_enabled? -%}
    <section class="comments narrow">
      <h2>HUDDLE TALK</h2>
      {%- for comment in article.comments -%}<article><strong>{{ comment.author }}</strong><p>{{ comment.content }}</p></article>{%- endfor -%}
      {% form 'new_comment', article %}
        {{ form.errors | default_errors }}
        <label for="CommentAuthor">Name</label><input id="CommentAuthor" name="comment[author]" value="{{ form.author }}" required>
        <label for="CommentEmail">E-Mail</label><input id="CommentEmail" type="email" name="comment[email]" value="{{ form.email }}" required>
        <label for="CommentBody">Kommentar</label><textarea id="CommentBody" name="comment[body]" rows="6" required>{{ form.body }}</textarea>
        <button class="button button--red" type="submit">KOMMENTAR SENDEN →</button>
      {% endform %}
    </section>
  {%- endif -%}
</article>

{% schema %}
{
  "name": "Blogartikel",
  "settings": [{ "type": "checkbox", "id": "show_author", "label": "Autor anzeigen", "default": true }]
}
{% endschema %}
