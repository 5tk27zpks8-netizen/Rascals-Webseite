<section class="search-page section-shell page-width">
  <header class="page-title"><p class="eyebrow eyebrow--red">FIND YOUR GEAR</p><h1>{{ 'general.search.search' | t }}</h1></header>
  <form action="{{ routes.search_url }}" method="get" role="search" class="search-form">
    <label class="visually-hidden" for="SearchInput">{{ 'general.search.search' | t }}</label>
    <input id="SearchInput" type="search" name="q" value="{{ search.terms | escape }}" placeholder="{{ 'general.search.placeholder' | t }}">
    <input type="hidden" name="options[prefix]" value="last">
    <button class="button button--red" type="submit">SUCHEN →</button>
  </form>
  {%- if search.performed -%}
    {%- paginate search.results by 20 -%}
      <p class="search-count">{{ search.results_count }} Treffer</p>
      <div class="product-grid">
        {%- for item in search.results -%}
          {%- if item.object_type == 'product' -%}{% render 'product-card', card_product: item %}{%- else -%}<article class="search-result reveal"><p class="eyebrow">{{ item.object_type }}</p><h2><a href="{{ item.url }}">{{ item.title | escape }}</a></h2><p>{{ item.content | strip_html | truncatewords: 28 }}</p></article>{%- endif -%}
        {%- else -%}<p>{{ 'general.search.no_results' | t: terms: search.terms }}</p>{%- endfor -%}
      </div>
      {% render 'pagination', paginate: paginate %}
    {%- endpaginate -%}
  {%- endif -%}
</section>

{% schema %}{ "name": "Suche", "settings": [] }{% endschema %}
