{%- liquid
  assign products_to_show = section.settings.products_to_show
  assign featured_collection = section.settings.collection
-%}
<section class="section-shell product-section">
  <div class="page-width">
    <div class="section-heading reveal">
      <div><p class="eyebrow eyebrow--red">{{ section.settings.eyebrow | escape }}</p><h2>{{ section.settings.heading | escape }}</h2></div>
      {%- if featured_collection != blank -%}<a class="text-link text-link--dark" href="{{ featured_collection.url }}">ALLE ANSEHEN <span>→</span></a>{%- endif -%}
    </div>
    <div class="product-grid">
      {%- if featured_collection != blank and featured_collection.products_count > 0 -%}
        {%- for product in featured_collection.products limit: products_to_show -%}
          {% render 'product-card', card_product: product, show_vendor: section.settings.show_vendor %}
        {%- endfor -%}
      {%- else -%}
        {%- for index in (1..4) -%}
          <article class="product-card reveal">
            <div class="product-card__media product-placeholder">{{ 'product-' | append: index | placeholder_svg_tag }}</div>
            <div class="product-card__body"><div><span class="eyebrow">RAS­CALS GEAR</span><h3>Dein Produkt {{ index }}</h3><div class="price"><strong>€59,00</strong></div></div><span class="quick-add">+</span></div>
          </article>
        {%- endfor -%}
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Featured products",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Subheading", "default": "NEW SEASON • NEW GEAR" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "STARTING LINEUP." },
    { "type": "collection", "id": "collection", "label": "Kollektion" },
    { "type": "range", "id": "products_to_show", "label": "Produktanzahl", "min": 2, "max": 8, "step": 1, "default": 4 },
    { "type": "checkbox", "id": "show_vendor", "label": "Anbieter anzeigen", "default": false }
  ],
  "presets": [{ "name": "Featured products" }]
}
{% endschema %}
