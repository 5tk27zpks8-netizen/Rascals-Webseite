<section class="contact-section section-shell page-width">
  <div class="contact-section__intro reveal"><p class="eyebrow eyebrow--red">TALK TO THE TEAM</p><h1>{{ page.title | default: section.settings.heading | escape }}</h1><div class="rte">{{ section.settings.text }}</div></div>
  <div class="contact-section__form reveal">
    {% form 'contact' %}
      {%- if form.posted_successfully? -%}<p class="form-success">Nachricht ist im Huddle angekommen.</p>{%- endif -%}
      {{ form.errors | default_errors }}
      <label for="ContactName">Name</label><input id="ContactName" type="text" name="contact[name]" value="{{ form.name }}" autocomplete="name">
      <label for="ContactEmail">E-Mail</label><input id="ContactEmail" type="email" name="contact[email]" value="{{ form.email }}" autocomplete="email" required>
      <label for="ContactPhone">Telefon</label><input id="ContactPhone" type="tel" name="contact[phone]" value="{{ form.phone }}" autocomplete="tel">
      <label for="ContactBody">Nachricht</label><textarea id="ContactBody" name="contact[body]" rows="7" required>{{ form.body }}</textarea>
      <button class="button button--red" type="submit">NACHRICHT SENDEN →</button>
    {% endform %}
  </div>
</section>

{% schema %}
{
  "name": "Kontaktformular",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "LET'S HUDDLE." },
    { "type": "richtext", "id": "text", "label": "Body text", "default": "<p>Fragen zu Größen, Versand oder deiner Bestellung? Schreib uns.</p>" }
  ],
  "presets": [{ "name": "Kontaktformular" }]
}
{% endschema %}
