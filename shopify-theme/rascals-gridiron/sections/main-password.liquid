<section class="password-locker">
  <div class="password-locker__bg"><img src="{{ 'helmet-hero.webp' | asset_url }}" width="3840" height="2160" alt="Rascals Football-Helm"></div>
  <div class="password-locker__content"><img src="{{ 'rascals-logo.png' | asset_url }}" width="300" height="150" alt="{{ shop.name }}"><p class="eyebrow">THE NEXT DROP IS COMING</p><h1>{{ section.settings.heading | escape }}</h1><p>{{ shop.password_message }}</p>{% form 'storefront_password' %}{{ form.errors | default_errors }}<label class="visually-hidden" for="Password">Passwort</label><input id="Password" type="password" name="password" placeholder="PASSWORT"><button class="button button--red" type="submit">ENTER →</button>{% endform %}</div>
</section>

{% schema %}
{
  "name": "Passwortseite",
  "settings": [{ "type": "text", "id": "heading", "label": "Heading", "default": "LOCKER ROOM CLOSED." }]
}
{% endschema %}
