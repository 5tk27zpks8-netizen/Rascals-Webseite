{%- if section.settings.text != blank -%}
  <div class="announcement" role="region" aria-label="Ankündigung">
    <div class="announcement__track">
      {%- for repetition in (1..4) -%}
        <span>
          {%- if section.settings.link != blank -%}<a href="{{ section.settings.link }}">{{ section.settings.text | escape }}</a>{%- else -%}{{ section.settings.text | escape }}{%- endif -%}
        </span>
      {%- endfor -%}
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Top bar",
  "settings": [
    { "type": "text", "id": "text", "label": "Text", "default": "OFFICIAL TEAMWEAR • ALL GRIT. ALL HEART." },
    { "type": "url", "id": "link", "label": "Link" }
  ]
}
{% endschema %}
