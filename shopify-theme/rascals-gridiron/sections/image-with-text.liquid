{%- liquid
  assign fallback_asset = section.settings.fallback_asset | default: 'team-entry.webp'
-%}
<section class="huddle-story{% if section.settings.reverse %} huddle-story--reverse{% endif %}">
  <div class="huddle-story__media reveal">
    {%- if section.settings.image != blank -%}
      {{ section.settings.image | image_url: width: 2400 | image_tag: widths: '650, 900, 1300, 1800, 2400', sizes: '(min-width: 900px) 55vw, 100vw', loading: 'lazy', alt: section.settings.image.alt }}
    {%- else -%}
      <img src="{{ fallback_asset | asset_url }}" width="3840" height="2160" loading="lazy" alt="Hellenstein Rascals laufen auf das Footballfeld">
    {%- endif -%}
    <span class="huddle-story__stamp">NO ONE<br>FIGHTS<br>ALONE.</span>
  </div>
  <div class="huddle-story__content reveal">
    <p class="eyebrow eyebrow--red">{{ section.settings.eyebrow | escape }}</p>
    <h2>{{ section.settings.heading | newline_to_br }}</h2>
    <div class="rte">{{ section.settings.text }}</div>
    {%- if section.settings.button_label != blank -%}<a class="button button--navy" href="{{ section.settings.button_link }}">{{ section.settings.button_label | escape }} <span>→</span></a>{%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Image and text",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Bild" },
    { "type": "select", "id": "fallback_asset", "label": "Standardmotiv", "default": "team-entry.webp", "options": [
      { "value": "team-entry.webp", "label": "Teameinlauf" },
      { "value": "team-players.webp", "label": "Spieler" },
      { "value": "shop-product.webp", "label": "Shop-Produkt" }
    ] },
    { "type": "text", "id": "eyebrow", "label": "Subheading", "default": "MORE THAN MERCH" },
    { "type": "textarea", "id": "heading", "label": "Heading", "default": "REP THE TEAM.\nJOIN THE FAMILY." },
    { "type": "richtext", "id": "text", "label": "Body text", "default": "<p>Jedes Piece trägt unsere Farben und unseren Anspruch: gemeinsam antreten, füreinander kämpfen und Heidenheim vertreten.</p>" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "UNSERE STORY" },
    { "type": "url", "id": "button_link", "label": "Button-Link" },
    { "type": "checkbox", "id": "reverse", "label": "Anordnung umkehren", "default": false }
  ],
  "presets": [{ "name": "Image and text" }]
}
{% endschema %}
