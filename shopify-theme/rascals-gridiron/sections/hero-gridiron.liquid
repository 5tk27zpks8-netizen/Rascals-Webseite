{%- liquid
  assign hero_image = section.settings.image
  assign fallback_image = 'helmet-hero.webp' | asset_url
-%}
<section class="hero-gridiron{% if section.settings.full_height %} hero-gridiron--full{% endif %}" data-hero>
  <div class="hero-gridiron__media">
    {%- if hero_image != blank -%}
      {{ hero_image | image_url: width: 3000 | image_tag: widths: '750, 1100, 1600, 2200, 3000', sizes: '100vw', loading: 'eager', fetchpriority: 'high', alt: hero_image.alt }}
    {%- else -%}
      <img src="{{ fallback_image }}" width="3840" height="2160" loading="eager" fetchpriority="high" alt="Hellenstein Rascals Football-Helm auf dem Spielfeld">
    {%- endif -%}
  </div>
  <div class="hero-gridiron__shade"></div>
  <div class="field-lines" aria-hidden="true"></div>
  <div class="hero-gridiron__content page-width reveal">
    {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
    <h1>{{ section.settings.heading | newline_to_br }}</h1>
    {%- if section.settings.text != blank -%}<div class="hero-gridiron__text rte">{{ section.settings.text }}</div>{%- endif -%}
    <div class="hero-gridiron__buttons">
      {%- if section.settings.button_label != blank -%}<a class="button button--red" href="{{ section.settings.button_link }}">{{ section.settings.button_label | escape }} <span>→</span></a>{%- endif -%}
      {%- if section.settings.secondary_label != blank -%}<a class="text-link" href="{{ section.settings.secondary_link }}">{{ section.settings.secondary_label | escape }} <span>↗</span></a>{%- endif -%}
    </div>
  </div>
  <div class="hero-number" aria-hidden="true">{{ section.settings.number }}</div>
  <div class="hero-scroll" aria-hidden="true"><span></span> SCROLL TO KICKOFF</div>
</section>

{% schema %}
{
  "name": "Football hero",
  "tag": "section",
  "class": "section-hero",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Bild" },
    { "type": "text", "id": "eyebrow", "label": "Subheading", "default": "OFFICIAL HELLENSTEIN RASCALS SHOP" },
    { "type": "textarea", "id": "heading", "label": "Heading", "default": "WEAR THE\nRASCALS." },
    { "type": "richtext", "id": "text", "label": "Body text", "default": "<p>Deine Farben. Dein Team. Dein nächster Spielzug.</p>" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "SHOP THE DROP" },
    { "type": "url", "id": "button_link", "label": "Button-Link" },
    { "type": "text", "id": "secondary_label", "label": "Zweiter Button label", "default": "ALLE PRODUKTE" },
    { "type": "url", "id": "secondary_link", "label": "Zweiter Button-Link" },
    { "type": "text", "id": "number", "label": "Hintergrundnummer", "default": "23" },
    { "type": "checkbox", "id": "full_height", "label": "Volle Bildschirmhöhe", "default": true }
  ],
  "presets": [{ "name": "Football hero" }]
}
{% endschema %}
