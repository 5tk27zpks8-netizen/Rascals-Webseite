<section class="section-shell rich-text-section">
  <div class="narrow reveal">
    {%- if section.settings.eyebrow != blank -%}<p class="eyebrow eyebrow--red">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
    <h2>{{ section.settings.heading | escape }}</h2>
    <div class="rte">{{ section.settings.text }}</div>
    {%- if section.settings.button_label != blank -%}<a class="button button--red" href="{{ section.settings.button_link }}">{{ section.settings.button_label | escape }} <span>→</span></a>{%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Rich text",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Subheading", "default": "HELLENSTEIN RASCALS" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "ALL GRIT. ALL HEART." },
    { "type": "richtext", "id": "text", "label": "Body text", "default": "<p>American Football in Heidenheim. Auf dem Feld und daneben: eine Familie.</p>" },
    { "type": "text", "id": "button_label", "label": "Button label" },
    { "type": "url", "id": "button_link", "label": "Button-Link" }
  ],
  "presets": [{ "name": "Rich text" }]
}
{% endschema %}
