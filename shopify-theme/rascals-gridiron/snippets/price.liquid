{%- liquid
  assign price_target = product.selected_or_first_available_variant
  assign price = price_target.price
  assign compare_at_price = price_target.compare_at_price
-%}
<div class="price{% if compare_at_price > price %} price--sale{% endif %}" data-price>
  {%- if compare_at_price > price -%}
    <span class="visually-hidden">Regulärer Preis</span>
    <s>{{ compare_at_price | money }}</s>
    <span class="visually-hidden">Aktionspreis</span>
  {%- endif -%}
  <strong>{{ price | money }}</strong>
  {%- if price_target.unit_price_measurement -%}
    <small>{{ price_target.unit_price | money }} / {{ price_target.unit_price_measurement.reference_value }}{{ price_target.unit_price_measurement.reference_unit }}</small>
  {%- endif -%}
</div>
