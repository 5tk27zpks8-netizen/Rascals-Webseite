<article class="product-card reveal" data-tilt-card>
  <a class="product-card__media" href="{{ card_product.url }}">
    {%- if card_product.featured_media -%}
      {{ card_product.featured_media | image_url: width: 900 | image_tag: widths: '320, 480, 640, 900', sizes: '(min-width: 990px) 25vw, 50vw', loading: 'lazy', alt: card_product.featured_media.alt }}
    {%- else -%}
      <div class="product-placeholder">{{ 'product-1' | placeholder_svg_tag }}</div>
    {%- endif -%}
    {%- if card_product.compare_at_price > card_product.price -%}<span class="product-badge">SALE</span>{%- endif -%}
  </a>
  <div class="product-card__body">
    <div>
      {%- if show_vendor -%}<span class="eyebrow">{{ card_product.vendor }}</span>{%- endif -%}
      <h3><a href="{{ card_product.url }}">{{ card_product.title | escape }}</a></h3>
      {% render 'price', product: card_product %}
    </div>
    {%- if card_product.available and card_product.has_only_default_variant -%}
      {% form 'product', card_product, class: 'quick-add' %}
        <input type="hidden" name="id" value="{{ card_product.selected_or_first_available_variant.id }}">
        <button type="submit" aria-label="{{ 'products.product.add_to_cart' | t }}: {{ card_product.title | escape }}">+</button>
      {% endform %}
    {%- else -%}
      <a class="quick-add quick-add--link" href="{{ card_product.url }}" aria-label="{{ card_product.title | escape }} ansehen">→</a>
    {%- endif -%}
  </div>
</article>
