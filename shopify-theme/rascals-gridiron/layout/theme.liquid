<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="theme-color" content="{{ settings.color_navy }}">
    <link rel="canonical" href="{{ canonical_url }}">

    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 64, height: 64 }}">
    {%- endif -%}

    {%- render 'meta-tags' -%}
    {{ content_for_header }}

    <style>
      :root {
        --navy: {{ settings.color_navy }};
        --navy-soft: {{ settings.color_navy_soft }};
        --red: {{ settings.color_red }};
        --ice: {{ settings.color_ice }};
        --white: #ffffff;
        --page-width: {{ settings.page_width }}px;
        --heading-scale: {{ settings.heading_scale | divided_by: 100.0 }};
        --logo-width: {{ settings.logo_width }}px;
      }
    </style>
    {{ 'base.css' | asset_url | stylesheet_tag }}
    <script src="{{ 'theme.js' | asset_url }}" defer></script>
  </head>

  <body class="template-{{ template.name | handle }}{% unless settings.use_motion %} motion-disabled{% endunless %}">
    <a class="skip-link" href="#MainContent">{{ 'accessibility.skip_to_text' | t }}</a>
    {% sections 'header-group' %}

    <main id="MainContent" role="main" tabindex="-1">
      {{ content_for_layout }}
    </main>

    {% sections 'footer-group' %}
    <div class="football-cursor" aria-hidden="true"></div>
    {%- render 'structured-data' -%}
  </body>
</html>
