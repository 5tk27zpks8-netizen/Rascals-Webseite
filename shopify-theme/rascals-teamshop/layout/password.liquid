<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="theme-color" content="{{ settings.color_ink | default: '#050b14' }}">
    <title>{{ shop.name }}</title>
    {{ content_for_header }}
    {%- comment -%} Dieselbe Schrift und dieselben Farben wie im Shop, sonst sieht die Passwortseite fremd aus. {%- endcomment -%}
    <link rel="preload" href="{{ 'saira-italic.woff2' | asset_url }}" as="font" type="font/woff2" crossorigin>
    <style>
      @font-face { font-family: "Saira"; src: url("{{ 'saira-normal.woff2' | asset_url }}") format("woff2"); font-weight: 100 900; font-stretch: 50% 125%; font-style: normal; font-display: swap; }
      @font-face { font-family: "Saira"; src: url("{{ 'saira-italic.woff2' | asset_url }}") format("woff2"); font-weight: 100 900; font-stretch: 50% 125%; font-style: italic; font-display: swap; }
      :root {
        --ink: {{ settings.color_ink | default: '#050b14' }}; --ink-2: {{ settings.color_ink_soft | default: '#0a1322' }};
        --navy: {{ settings.color_navy | default: '#0f1d2c' }}; --red: {{ settings.color_red | default: '#d4102a' }};
        --ice: {{ settings.color_ice | default: '#eef0f3' }}; --white: #fff;
        --page-width: {{ settings.page_width }}px; --heading-scale: 1; --logo-width: {{ settings.logo_width }}px;
      }
    </style>
    {{ 'teamshop.css' | asset_url | stylesheet_tag }}
  </head>
  <body class="password-page">
    <main id="MainContent">{{ content_for_layout }}</main>
  </body>
</html>
