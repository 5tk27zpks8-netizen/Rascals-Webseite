[
  {
    "name": "theme_info",
    "theme_name": "Rascals Teamshop",
    "theme_author": "Hellenstein Rascals",
    "theme_version": "1.0.0",
    "theme_documentation_url": "https://shopify.dev/docs/storefronts/themes",
    "theme_support_email": "football@hsb1846.de"
  },
  {
    "name": "Marke",
    "settings": [
      {
        "type": "image_picker",
        "id": "logo",
        "label": "Logo",
        "info": "Nur nötig, wenn ein anderes Logo erscheinen soll. Ohne Auswahl zeigt das Theme das Rascals-Logo mit Schriftzug."
      },
      {
        "type": "range",
        "id": "logo_width",
        "min": 110,
        "max": 260,
        "step": 10,
        "unit": "px",
        "label": "Logobreite",
        "default": 140
      },
      {
        "type": "image_picker",
        "id": "favicon",
        "label": "Favicon"
      },
      {
        "type": "header",
        "content": "Farben"
      },
      {
        "type": "color",
        "id": "color_ink",
        "label": "Dunkel (Servicezeile, Footer)",
        "default": "#050b14"
      },
      {
        "type": "color",
        "id": "color_ink_soft",
        "label": "Dunkel, Flächen (Header, Kacheln)",
        "default": "#0a1322"
      },
      {
        "type": "color",
        "id": "color_navy",
        "label": "Navy (Schrift auf hellem Grund, Hero)",
        "default": "#0f1d2c"
      },
      {
        "type": "color",
        "id": "color_red",
        "label": "Rot",
        "default": "#d4102a"
      },
      {
        "type": "color",
        "id": "color_ice",
        "label": "Heller Grund (Produktseiten)",
        "default": "#eef0f3"
      }
    ]
  },
  {
    "name": "Layout",
    "settings": [
      {
        "type": "range",
        "id": "page_width",
        "min": 1100,
        "max": 1600,
        "step": 50,
        "unit": "px",
        "label": "Maximale Seitenbreite",
        "default": 1400
      },
      {
        "type": "range",
        "id": "heading_scale",
        "min": 80,
        "max": 130,
        "step": 5,
        "unit": "%",
        "label": "Überschriftengröße",
        "default": 100
      },
      {
        "type": "checkbox",
        "id": "use_motion",
        "label": "Animationen aktivieren",
        "default": true
      }
    ]
  },
  {
    "name": "Social Media",
    "settings": [
      {
        "type": "url",
        "id": "instagram_url",
        "label": "Instagram-URL"
      },
      {
        "type": "url",
        "id": "facebook_url",
        "label": "Facebook-URL"
      }
    ]
  }
]
