{%- comment -%}
  DAS LAUFBAND GANZ OBEN.

  Ein duennes rotes Band ueber der Serviceleiste, der Text wandert von
  rechts nach links. Wie im ersten Rascals-Shop.

  Die Spur besteht aus zwei gleichen Haelften und laeuft um -50 % weiter;
  so schliesst die Schleife nahtlos. Die zweite Haelfte ist fuer
  Screenreader ausgeblendet, damit der Satz nicht doppelt vorgelesen wird.
  Mit der Maus darueber haelt das Band an; bei "Bewegung reduzieren" steht
  es still.
{%- endcomment -%}
{%- if section.settings.text != blank -%}
  <div class="top-ticker" role="region" aria-label="{{ section.settings.label | escape }}" style="--top-ticker-speed: {{ section.settings.speed }}s;">
    <div class="top-ticker__track">
      {%- for half in (1..2) -%}
        <div class="top-ticker__half"{% if half == 2 %} aria-hidden="true"{% endif %}>
          {%- for repetition in (1..5) -%}
            <span>
              {%- if section.settings.link != blank -%}
                <a href="{{ section.settings.link }}"{% if half == 2 or repetition > 1 %} tabindex="-1"{% endif %}>{{ section.settings.text | escape }}</a>
              {%- else -%}
                {{ section.settings.text | escape }}
              {%- endif -%}
            </span>
          {%- endfor -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Laufband oben",
  "settings": [
    { "type": "text", "id": "text", "label": "Text", "default": "OFFICIAL TEAMWEAR • ALL GRIT. ALL HEART." },
    { "type": "url", "id": "link", "label": "Link" },
    { "type": "text", "id": "label", "label": "Barrierefreie Bezeichnung", "default": "Ankündigung" },
    { "type": "range", "id": "speed", "label": "Ein Durchlauf in Sekunden", "min": 15, "max": 90, "step": 5, "default": 35, "info": "Größer = langsamer." }
  ],
  "presets": [{ "name": "Laufband oben" }]
}
{% endschema %}
