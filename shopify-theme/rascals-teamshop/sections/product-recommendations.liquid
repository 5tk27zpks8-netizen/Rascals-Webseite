<product-recommendations class="recommendations section-shell" data-url="{{ routes.product_recommendations_url }}?limit={{ section.settings.products_to_show }}&product_id={{ product.id }}&section_id={{ section.id }}">
  {%- if recommendations.performed? and recommendations.products_count > 0 -%}
    <div class="page-width">
      <div class="section-heading"><div><p class="eyebrow eyebrow--red">NEXT PLAY</p><h2>{{ section.settings.heading | escape }}</h2></div></div>
      <div class="product-grid">{%- for product in recommendations.products -%}{% render 'product-card', card_product: product %}{%- endfor -%}</div>
    </div>
  {%- endif -%}
</product-recommendations>

{% schema %}
{
  "name": "Produktempfehlungen",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "COMPLETE THE FIT." },
    { "type": "range", "id": "products_to_show", "label": "Produktanzahl", "min": 2, "max": 8, "step": 1, "default": 4 }
  ]
}
{% endschema %}
