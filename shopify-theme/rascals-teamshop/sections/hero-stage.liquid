{%- comment -%}
  DER HERO: EINE BUEHNE BEI NACHT.

  Aufgebaut wie die Vorlage, von hinten nach vorn:

    1. Stadion links: Tribuenen und Flutlicht, dunkel und unscharf.
    2. Rechts der Helm auf dem Rasen, Blick nach links zur Schlagzeile, mit
       dem Rascals-Logo als Aufkleber. Das Foto steht nicht ueber die ganze
       Breite, sondern rechts angeschlagen und nach links ausgeblendet —
       sonst laege der Helm hinter der Schlagzeile. Die Breite ist
       einstellbar, damit der Helm groesser oder kleiner wirkt.
    3. Links die Rueckenfigur (Spieler von hinten), vor dem Stadion.
    4. Ein Schleier, der nur so dunkel ist, wie die Schrift es braucht.

  DIE BUEHNE LAEUFT UNTER DEN KACHELN WEITER.
  In der Vorlage stehen die Kategoriekacheln auf dem Rasen des Heros. Der
  Hero ist deshalb hoeher als sein Text und laesst unten Platz; die
  Kachelreihe schiebt sich mit negativem Abstand hinein.

  Alles ausser dem Text ist Dekoration und fuer Screenreader ausgeblendet.
  Unter prefers-reduced-motion steht die Buehne still.
{%- endcomment -%}
{%- liquid
  assign stage_src = 'stage-helmet.webp' | asset_url
  if section.settings.stage_image != blank
    assign stage_src = section.settings.stage_image | image_url: width: 2400
  endif
  assign back_src = 'hero-stadium.webp' | asset_url
  if section.settings.backdrop != blank
    assign back_src = section.settings.backdrop | image_url: width: 1920
  endif
  assign figure_src = 'stage-figure.webp' | asset_url
  if section.settings.figure != blank
    assign figure_src = section.settings.figure | image_url: width: 900
  endif
  assign heading_lines = section.settings.heading | strip | newline_to_br | split: '<br />'
  assign meta_items = section.settings.meta | split: '|'
-%}
<section class="hero-stage{% if section.settings.under_tiles %} hero-stage--under-tiles{% endif %}"
         style="--stage-w: {{ section.settings.stage_width }}%; --stage-x: {{ section.settings.stage_offset }}%; --figure-h: {{ section.settings.figure_height }}%; --figure-o: {{ section.settings.figure_opacity | divided_by: 100.0 }};">
  <div class="hero-stage__layers" aria-hidden="true">
    <img class="hero-stage__backdrop" src="{{ back_src }}" width="1920" height="740" alt="" loading="eager">
    <span class="hero-stage__lights hero-stage__lights--left"></span>
    <span class="hero-stage__lights hero-stage__lights--right"></span>
    <div class="hero-stage__stage">
      <img class="hero-stage__photo" src="{{ stage_src }}" width="2400" height="1800" alt="" loading="eager" fetchpriority="high">
    </div>
    {%- if section.settings.show_figure -%}
      <img class="hero-stage__figure" src="{{ figure_src }}" width="780" height="1448" alt="" loading="eager">
    {%- endif -%}
    <span class="hero-stage__scrim"></span>
  </div>

  <div class="hero-stage__content page-width">
    <div class="hero-stage__copy reveal">
      {%- if section.settings.eyebrow != blank -%}<p class="hero-stage__eyebrow">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
      <h1 class="hero-stage__title">
        {%- for line in heading_lines -%}
          {%- assign clean = line | strip_html | strip -%}
          {%- if clean == blank -%}{%- continue -%}{%- endif -%}
          <span class="hero-stage__line{% unless forloop.first %} hero-stage__line--red{% endunless %}">{{ clean }}</span>
        {%- endfor -%}
      </h1>
      {%- if section.settings.meta != blank -%}
        <ul class="hero-stage__meta" role="list">
          {%- for item in meta_items -%}
            {%- assign label = item | strip -%}
            {%- if label != blank -%}<li>{{ label | escape }}</li>{%- endif -%}
          {%- endfor -%}
        </ul>
      {%- endif -%}
      <div class="hero-stage__buttons">
        {%- if section.settings.button_label != blank -%}
          <a class="button button--red button--skew" href="{{ section.settings.button_link | default: routes.all_products_collection_url }}">
            {%- unless section.settings.button_icon == 'none' -%}{%- render 'line-icon', name: section.settings.button_icon -%}{%- endunless -%}
            <span>{{ section.settings.button_label | escape }}</span>
            <b class="arrow" aria-hidden="true">{%- render 'line-icon', name: 'arrow' -%}</b>
          </a>
        {%- endif -%}
        {%- if section.settings.secondary_label != blank -%}
          <a class="button button--ghost button--skew" href="{{ section.settings.secondary_link | default: routes.collections_url }}">
            {%- unless section.settings.secondary_icon == 'none' -%}{%- render 'line-icon', name: section.settings.secondary_icon -%}{%- endunless -%}
            <span>{{ section.settings.secondary_label | escape }}</span>
          </a>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hero: Bühne",
  "tag": "section",
  "class": "section-hero",
  "settings": [
    { "type": "header", "content": "Text" },
    { "type": "text", "id": "eyebrow", "label": "Kleine Zeile", "default": "HELLENSTEIN RASCALS" },
    { "type": "textarea", "id": "heading", "label": "Schlagzeile", "default": "OFFIZIELLE\nTEAMWEAR", "info": "Alles ab der zweiten Zeile wird rot." },
    { "type": "text", "id": "meta", "label": "Einordnung", "default": "TEAM | TRAINING | COACHES | FANS", "info": "Mit | trennen." },
    { "type": "text", "id": "button_label", "label": "Button", "default": "ZUM SHOP" },
    { "type": "url", "id": "button_link", "label": "Button-Link" },
    { "type": "select", "id": "button_icon", "label": "Symbol im Button", "default": "bag",
      "options": [{ "value": "bag", "label": "Einkaufstasche" }, { "value": "shirt", "label": "Shirt" }, { "value": "star", "label": "Stern" }, { "value": "none", "label": "Keins" }] },
    { "type": "text", "id": "secondary_label", "label": "Zweiter Button", "default": "KOLLEKTION ENTDECKEN" },
    { "type": "url", "id": "secondary_link", "label": "Link des zweiten Buttons" },
    { "type": "select", "id": "secondary_icon", "label": "Symbol im zweiten Button", "default": "play",
      "options": [{ "value": "play", "label": "Play" }, { "value": "star", "label": "Stern" }, { "value": "tag", "label": "Anhänger" }, { "value": "none", "label": "Keins" }] },

    { "type": "header", "content": "Bühne rechts" },
    { "type": "image_picker", "id": "stage_image", "label": "Bild rechts", "info": "Leer lassen: Rascals-Helm auf dem Rasen." },
    { "type": "range", "id": "stage_width", "min": 40, "max": 90, "step": 2, "unit": "%", "label": "Größe des Bildes", "default": 50, "info": "Kleiner = Helm kleiner. Das Bild steht unten auf den Kacheln auf." },
    { "type": "range", "id": "stage_offset", "min": -20, "max": 10, "step": 1, "unit": "%", "label": "Abstand zum rechten Rand", "default": -3, "info": "Negativ schiebt das Bild über den Rand hinaus." },

    { "type": "header", "content": "Hintergrund und Figur links" },
    { "type": "image_picker", "id": "backdrop", "label": "Stadion", "info": "Leer lassen: Rascals-Stadion aus dem Theme." },
    { "type": "checkbox", "id": "show_figure", "label": "Figur links zeigen", "default": true },
    { "type": "image_picker", "id": "figure", "label": "Figur links", "info": "Leer lassen: Spieler von hinten (Jubelfoto)." },
    { "type": "range", "id": "figure_height", "min": 50, "max": 130, "step": 2, "unit": "%", "label": "Höhe der Figur", "default": 108 },
    { "type": "range", "id": "figure_opacity", "min": 20, "max": 100, "step": 5, "unit": "%", "label": "Deckkraft der Figur", "default": 100 },

    { "type": "header", "content": "Aufbau" },
    { "type": "checkbox", "id": "under_tiles", "label": "Bühne läuft unter den Kategoriekacheln weiter", "default": true }
  ],
  "presets": [{ "name": "Hero: Bühne" }]
}
{% endschema %}
